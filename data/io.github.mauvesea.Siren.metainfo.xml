<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.mauvesea.Siren</id>
  <name>Siren</name>
  <summary>Convert and audition pokecrystal cries</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.mauvesea">
    <name>Mauvesea</name>
  </developer>
  <url type="homepage">https://github.com/mauvesea/siren</url>
  <description>
    <p>
      Siren converts .wav files into usable pokecrystal .asm cries. It analyzes
      the audio, offers hardware-native effects, and lets users compare the
      source with the synthesized result. Its parameter validator opens cry
      .asm files and previews pokecrystal pitch and length values without
      modifying or exporting the file.
    </p>
  </description>
  <launchable type="desktop-id">io.github.mauvesea.Siren.desktop</launchable>
  <provides>
    <binary>siren</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="2.0.0" date="2026-09-22"/>
    <release version="1.1.0" date="2026-09-21"/>
  </releases>
</component>
